# Required for production builds (`next build` / `next start`).
# Absolute origin only: scheme + host, no trailing slash, not localhost.
# NEXT_PUBLIC_SITE_URL=https://example.com

# Optional public contacts. Empty values hide the corresponding links.
# Email: address only, no mailto:
# NEXT_PUBLIC_CONTACT_EMAIL=example@example.com
# Telegram: username only, no https://t.me/
# NEXT_PUBLIC_CONTACT_TELEGRAM=username
# GitHub: full profile URL
# NEXT_PUBLIC_CONTACT_GITHUB=https://github.com/username
